# Create a free project at https://www.sanity.io/manage and fill these in.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# sanity.io/manage -> API -> Tokens -> Add API token (Editor permission)
SANITY_API_WRITE_TOKEN=

# Card giving (Flutterwave). Create a free account at https://dashboard.flutterwave.com,
# then Settings -> API Keys. Use the "Test" keys until you're ready to go live.
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
